# Fichier .env du SERVEUR (ium.lamajestueuse.com).
# À copier en .env à la racine de l'application, puis à compléter.
# Il n'est jamais envoyé par le pipeline : il reste sur le serveur.

APP_NAME="IUM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Tant que le certificat n'est pas emis, le site repond en clair : laissez
# http:// ici, et passez a https:// le jour ou SSL/TLS est actif.
APP_URL=http://ium.lamajestueuse.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# Journaux : un fichier par jour, seulement les erreurs.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Un cookie « securise » n'est pas renvoye sur une connexion en clair : sur
# http, personne ne resterait connecte. A passer a true avec le certificat.
SESSION_SECURE_COOKIE=false

QUEUE_CONNECTION=database
CACHE_STORE=database

# Relais d'envoi : les mêmes réglages que le portail du groupe.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="info@lamajestueuse.com"
MAIL_FROM_NAME="IUM"
